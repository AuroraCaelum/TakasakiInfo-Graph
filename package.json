{
  "name": "takasakiinfo-graph",
  "private": true,
  "version": "0.1.0",
  "description": "Interactive connection map of the TakasakiInfo Love Live! database",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "data": "tsx scripts/build-data.ts",
    "dev": "vite",
    "build": "npm run data && npm run build:web",
    "build:web": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "test": "vitest run"
  },
  "dependencies": {
    "@sigma/edge-curve": "3.1.0",
    "@sigma/node-image": "3.0.0",
    "graphology": "0.26.0",
    "graphology-layout-forceatlas2": "0.10.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "sigma": "3.0.3",
    "zustand": "5.0.15"
  },
  "devDependencies": {
    "@types/node": "22.20.3",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "@vitejs/plugin-react": "5.2.0",
    "graphology-communities-louvain": "2.0.2",
    "graphology-layout-noverlap": "0.4.2",
    "graphology-metrics": "2.4.2",
    "graphology-types": "0.24.8",
    "tsx": "4.23.13",
    "typescript": "5.9.3",
    "vite": "7.3.6",
    "vitest": "3.2.7"
  }
}
